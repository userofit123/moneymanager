# Copy to .env (chmod 600). Never commit .env or the secrets/ folder.
POSTGRES_PASSWORD=change-me
# Wise personal token (read-only). Leave empty to use CSV import only.
WISE_TOKEN=
# Shared key between the app and the scraper container
SCRAPER_KEY=change-me-too
# Sync every 8 hours (cron). Balances can be synced more often once Wise rate limits are checked.
SYNC_CRON=0 */8 * * *
# Host port the app listens on (Caddy proxies to it). 9008 is reserved for n8n.
APP_PORT=9010
# Set to 1 only to try the screens with sample data on an empty database
ALLOW_DEMO_SEED=0

# ./setup.sh creates .env from this file with random secrets. Never commit .env.
POSTGRES_PASSWORD=
SCRAPER_KEY=

# Where the app listens. 127.0.0.1 keeps it on this machine; Caddy or Tailscale serve it onwards.
# Use BIND=0.0.0.0 only on a trusted home network, and prefer HTTPS in front of it.
BIND=127.0.0.1
APP_PORT=8787
# Set to 1 when a reverse proxy (Caddy) terminates HTTPS in front of the app
TRUST_PROXY=0

# Default for how far the first import of a bank goes back (days). Change it in Settings → Connections.
HISTORY_DAYS=365
SESSION_DAYS=14

# Optional: Wise token here instead of Settings → Connections
WISE_TOKEN=

# 1 = when a bank login gets stuck, save a screenshot you can copy out (see README, "Troubleshooting a scraper")
SCRAPER_DEBUG=0

{
  "name": "money-manager-desktop",
  "productName": "Money Manager",
  "version": "0.12.1",
  "description": "Money Manager for Windows and Linux: the same app, with its own database and bank scraper built in",
  "private": true,
  "main": "main.js",
  "desktopName": "money-manager.desktop",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never",
    "release": "electron-builder --win --x64 --publish always",
    "dist:linux": "electron-builder --linux --x64 --publish never",
    "release:linux": "electron-builder --linux --x64 --publish always",
    "test": "node --test"
  },
  "dependencies": {
    "electron-updater": "^6.6.0"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.moneymanager.desktop",
    "productName": "Money Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "launcher.js",
      "preload.js",
      "shellserver.js",
      "hybrid-preload.js",
      "remote-preload.js",
      "servers.js",
      "servers.html",
      "servers-preload.js",
      "texts.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "**/*",
          "!test/**",
          "!data/**",
          "!Dockerfile*"
        ]
      },
      {
        "from": "../scraper",
        "to": "scraper",
        "filter": [
          "**/*",
          "!test/**",
          "!data/**",
          "!Dockerfile*"
        ]
      },
      {
        "from": "../frontend/dist",
        "to": "web"
      },
      {
        "from": "chrome",
        "to": "chrome"
      },
      {
        "from": "../CHANGELOG.md",
        "to": "CHANGELOG.md"
      },
      {
        "from": "../CHANGELOG.he.md",
        "to": "CHANGELOG.he.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../frontend/public/icon-512.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "guid": "6f1c1c0e-7a52-4d0b-9f0e-3b6a2f6d5c11"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "userofit123",
        "repo": "moneymanager",
        "releaseType": "release"
      }
    ],
    "releaseInfo": {
      "releaseNotesFile": "release-notes.md"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../frontend/public/icon-512.png",
      "category": "Office;Finance",
      "synopsis": "Your money in one private place",
      "description": "Money Manager gathers your bank, card and cash accounts on your own computer, with nothing sent anywhere.",
      "executableName": "money-manager",
      "artifactName": "Money-Manager-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Money Manager",
          "Comment": "Your money in one private place",
          "StartupWMClass": "Money Manager"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ],
      "fpm": [
        "build/money-manager.metainfo.xml=/usr/share/metainfo/money-manager.metainfo.xml"
      ]
    },
    "rpm": {
      "fpm": [
        "build/money-manager.metainfo.xml=/usr/share/metainfo/money-manager.metainfo.xml"
      ]
    }
  },
  "homepage": "https://github.com/userofit123/moneymanager",
  "author": {
    "name": "Money Manager",
    "email": "45289144+userofit123@users.noreply.github.com"
  }
}
